{
  "name": "tygygydyk/composer-dependency-scanner",
  "description": "Composer Dependency Scanner",
  "type": "library",
  "require": {
    "php": "^8.2",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0"
  },
  "config": {
    "lock": false
  },
  "autoload": {
    "psr-4": {
      "Tygygydyk\\ComposerDependencyScanner\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
